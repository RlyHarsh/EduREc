# ==============================================================================
# EduRec Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides (never commit real .env files)
#
# Server Host (default: 127.0.0.1 for local isolation, 0.0.0.0 for containerized deployment)
HOST=127.0.0.1

# Server Port (default: 8080)
PORT=8080

# Environment mode (development / production)
ENVIRONMENT=development
